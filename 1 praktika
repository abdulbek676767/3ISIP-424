using System;
using System.Collections.Generic;
using System.Linq;
class Program
{
    struct Expense { public string Name; public decimal Amount; }
    static List<Expense> expenses = new List<Expense>();
    static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;
        int count;
        while (true)
        {
            Console.WriteLine("Введите количество операций (2-40):");
            if (int.TryParse(Console.ReadLine(), out count) && count >= 2 && count <= 40) break;
        }
        for (int i = 0; i < count; i++)
        {
            Console.Write("Название товара/услуги: ");
            string name = Console.ReadLine();
            decimal amount;
            while (true)
            {
                Console.Write("Сумма в рублях: ");
                if (decimal.TryParse(Console.ReadLine(), out amount) && amount > 0) break;
            }
            expenses.Add(new Expense { Name = name, Amount = amount });
        }
        while (true)
        {
            Console.WriteLine("\n1-Вывод данных  2-Статистика  3-Сортировка  4-Конвертация  5-Поиск  0-Выход");
            string choice = Console.ReadLine();
            switch (choice)
            {
                case "1":
                    Console.WriteLine("\nСписок расходов:");
                    for (int i = 0; i < expenses.Count; i++)
                        Console.WriteLine($"{i + 1}. {expenses[i].Name}: {expenses[i].Amount} рублей");
                    break;
                case "2":
                    if (expenses.Count > 0)
                    {
                        decimal sum = expenses.Sum(e => e.Amount);
                        Console.WriteLine($"\nОбщая сумма: {sum:F2} рублей");
                        Console.WriteLine($"Среднее значение: {sum / expenses.Count:F2} рублей");
                        Console.WriteLine($"Максимум: {expenses.Max(e => e.Amount):F2} рублей");
                        Console.WriteLine($"Минимум: {expenses.Min(e => e.Amount):F2} рублей");
                    }
                    break;
                case "3":
                    for (int i = 0; i < expenses.Count - 1; i++)
                        for (int j = 0; j < expenses.Count - i - 1; j++)
                            if (expenses[j].Amount > expenses[j + 1].Amount)
                            { var t = expenses[j]; expenses[j] = expenses[j + 1]; expenses[j + 1] = t; }
                    Console.WriteLine("\nДанные отсортированы по цене!");
                    for (int i = 0; i < expenses.Count; i++)
                        Console.WriteLine($"{i + 1}. {expenses[i].Name}: {expenses[i].Amount} рублей");
                    break;
                case "4":
                    if (expenses.Count > 0)
                    {
                        decimal sum = expenses.Sum(e => e.Amount);
                        Console.WriteLine("\n1-Ввести курс вручную  2-Выбрать из списка");
                        if (Console.ReadLine() == "1")
                        {
                            Console.Write("Введите курс валюты: ");
                            if (decimal.TryParse(Console.ReadLine(), out decimal r) && r > 0)
                                Console.WriteLine($"\n{sum} рублей = {sum / r} иностранной валюты");
                        }
                        else
                        {
                            Console.WriteLine("\n1-USD (доллар)  2-EUR (евро)  3-KZT (тенге)  4-BYN (беларусский рубль)");
                            decimal rate = Console.ReadLine() switch { "1" => 0.013m, "2" => 0.012m, "3" => 5.5m, "4" => 0.035m, _ => -1 };
                            if (rate > 0) Console.WriteLine($"\n{sum} рублей = {sum * rate} иностранной валюты");
                        }
                    }
                    break;
                case "5":

                    Console.Write("\nВведите название для поиска: ");
                    var found = expenses.Where(e => e.Name.ToLower().Contains(Console.ReadLine().ToLower())).ToList();
                    Console.WriteLine("\nРезультаты поиска:");
                    foreach (var e in found) Console.WriteLine($"{e.Name}: {e.Amount} рублей");
                    if (found.Count == 0) Console.WriteLine("Ничего не найдено");
                    break;
                case "0": return;
            }
        }
    }
}
