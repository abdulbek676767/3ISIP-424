using System;
using System.Collections.Generic;
using System.Linq;

class Program
{
    static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;
        
        List<string> names = new List<string>();
        List<decimal> amounts = new List<decimal>();
        
        int count;
        while (true)
        {
            Console.WriteLine("Введите количество операций (2-40):");
            if (int.TryParse(Console.ReadLine(), out count) && count >= 2 && count <= 40) break;
        }
        
        for (int i = 0; i < count; i++)
        {
            Console.Write("Название товара/услуги: ");
            string name = Console.ReadLine();
            names.Add(name);
            
            decimal amount;
            while (true)
            {
                Console.Write("Сумма в рублях: ");
                if (decimal.TryParse(Console.ReadLine(), out amount) && amount > 0) break;
            }
            amounts.Add(amount);
        }
        
        while (true)
        {
            Console.WriteLine("\n1-Вывод данных  2-Статистика  3-Сортировка  4-Конвертация  5-Поиск  0-Выход");
            string choice = Console.ReadLine();
            
            switch (choice)
            {
                case "1":
                    Console.WriteLine("\nСписок расходов:");
                    for (int i = 0; i < names.Count; i++)
                        Console.WriteLine($"{i+1}. {names[i]}: {amounts[i]} рублей");
                    break;
                    
                case "2":
                    if (names.Count > 0)
                    {
                        decimal sum = 0;
                        for (int i = 0; i < amounts.Count; i++)
                            sum = sum + amounts[i];
                        
                        decimal average = sum / names.Count;
                        
                        decimal max = amounts[0];
                        for (int i = 1; i < amounts.Count; i++)
                            if (amounts[i] > max)
                                max = amounts[i];
                        
                        decimal min = amounts[0];
                        for (int i = 1; i < amounts.Count; i++)
                            if (amounts[i] < min)
                                min = amounts[i];
                        
                        Console.WriteLine($"\nОбщая сумма: {sum:F2} рублей");
                        Console.WriteLine($"Среднее значение: {average:F2} рублей");
                        Console.WriteLine($"Максимум: {max:F2} рублей");
                        Console.WriteLine($"Минимум: {min:F2} рублей");
                    }
                    break;
                    
                case "3":
                    for (int i = 0; i < amounts.Count-1; i++)
                        for (int j = 0; j < amounts.Count-i-1; j++)
                            if (amounts[j] > amounts[j+1])
                            {
                                decimal tempAmount = amounts[j];
                                amounts[j] = amounts[j+1];
                                amounts[j+1] = tempAmount;
                                
                                string tempName = names[j];
                                names[j] = names[j+1];
                                names[j+1] = tempName;
                            }
                    
                    Console.WriteLine("\nДанные отсортированы по цене!");
                    for (int i = 0; i < names.Count; i++)
                        Console.WriteLine($"{i+1}. {names[i]}: {amounts[i]} рублей");
                    break;
                    
                case "4":
                    if (names.Count > 0)
                    {
                        decimal sum = 0;
                        for (int i = 0; i < amounts.Count; i++)
                            sum = sum + amounts[i];
                        
                        Console.WriteLine("\n1-Ввести курс вручную  2-Выбрать из списка");
                        string choice2 = Console.ReadLine();
                        
                        if (choice2 == "1")
                        {
                            Console.Write("Введите курс валюты: ");
                            if (decimal.TryParse(Console.ReadLine(), out decimal r) && r > 0)
                                Console.WriteLine($"\n{sum} рублей = {sum/r} иностранной валюты");
                        }
                        else
                        {
                            Console.WriteLine("\n1-USD (доллар)  2-EUR (евро)  3-KZT (тенге)  4-BYN (беларусский рубль)");
                            string choice3 = Console.ReadLine();
                            decimal rate = -1;
                            
                            if (choice3 == "1") rate = 0.013m;
                            else if (choice3 == "2") rate = 0.012m;
                            else if (choice3 == "3") rate = 5.5m;
                            else if (choice3 == "4") rate = 0.035m;
                            
                            if (rate > 0)
                                Console.WriteLine($"\n{sum} рублей = {sum*rate} иностранной валюты");
                        }
                    }
                    break;
                    
                case "5":
                    Console.Write("\nВведите название для поиска: ");
                    string searchTerm = Console.ReadLine().ToLower();
                    Console.WriteLine("\nРезультаты поиска:");
                    bool found = false;
                    for (int i = 0; i < names.Count; i++)
                    {
                       
                        if (names[i].ToLower().Contains(searchTerm))
                        {

                            Console.WriteLine($"{names[i]}: {amounts[i]} рублей");
                            found = true;
                        }
                    }
                    if (!found)
                        Console.WriteLine("Ничего не найдено");
                    break;
                    
                case "0": return;
            }
        }
    }
}
